{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(scripts/test.sh*)",
      "Bash(ruff *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-protected-files.sh"
          }
        ]
      }
    ]
  }
}
